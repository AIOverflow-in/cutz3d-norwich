# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://your-domain.co.uk

# Neon Postgres (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Salon schedule (Europe/London, Sunday closed)
SALON_TIMEZONE=Europe/London
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=18
BOOKING_CLOSED_DAYS=0

# Passwordless admin access
ADMIN_EMAIL=owner@example.com

# Resend notifications
RESEND_API_KEY=re_your_key
EMAIL_FROM="3D Cutz <bookings@your-domain.co.uk>"
BOOKING_NOTIFY_EMAIL=owner@example.com
BOOKING_REPLY_TO=owner@example.com

# Automated weekly journal
OPENAI_API_KEY=sk-your_key
BLOG_MODEL=gpt-5-mini
